# =============================================================================
# azure-res-cdn-profile/modules/afd-endpoint tests
# =============================================================================
# `mock_provider` keeps the suite offline: negative runs abort during variable
# validation, and the positive runs need a resource graph but not a real
# subscription.
#
# Caveat: mocking bypasses AzAPI's own schema checks, so the positive runs cannot
# confirm ARM accepts a body. The variable validation blocks are the guard.
# =============================================================================

mock_provider "azapi" {}

variables {
  cdn_profile_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Cdn/profiles/afd-example"
  name                    = "ep-example"
  routes = {
    maintenance = {
      origin_group_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Cdn/profiles/afd-example/originGroups/og-example"
    }
  }
}

# =============================================================================
# POSITIVE — resource graph and outputs must actually evaluate
# =============================================================================

run "plans_an_endpoint_with_a_default_route" {
  command = plan

  assert {
    condition = (
      azapi_resource.this.location == "global" &&
      azapi_resource.this.body.properties.autoGeneratedDomainNameLabelScope == "TenantReuse" &&
      azapi_resource.this.body.properties.enabledState == "Enabled"
    )
    error_message = "the endpoint must be global, enabled and reuse its label tenant-wide by default"
  }
  assert {
    condition = (
      azapi_resource.route["maintenance"].body.properties.supportedProtocols == tolist(["Https"]) &&
      azapi_resource.route["maintenance"].body.properties.forwardingProtocol == "HttpsOnly" &&
      azapi_resource.route["maintenance"].body.properties.httpsRedirect == "Disabled" &&
      azapi_resource.route["maintenance"].body.properties.linkToDefaultDomain == "Enabled"
    )
    error_message = "a route must default to HTTPS in and out, on the default domain"
  }
  assert {
    condition = (
      azapi_resource.route["maintenance"].body.properties.cacheConfiguration == null &&
      azapi_resource.route["maintenance"].body.properties.originPath == null
    )
    error_message = "an uncached route without an origin path must send both as null"
  }
  assert {
    condition     = azapi_resource.route["maintenance"].body.properties.patternsToMatch == tolist(["/*"])
    error_message = "a route must match /* by default"
  }
  assert {
    condition     = length(azapi_resource.security_policy) == 0
    error_message = "no security policy may be created without security_policy"
  }
}

run "plans_a_cached_route_behind_a_waf_policy" {
  command = plan

  variables {
    routes = {
      maintenance = {
        origin_group_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Cdn/profiles/afd-example/originGroups/og-example"
        patterns_to_match        = ["/maintenance/*"]
        origin_path              = "/maintenance"
        cache                    = {}
      }
    }
    security_policy = {
      waf_policy_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Network/frontDoorWebApplicationFirewallPolicies/wafexample"
    }
  }

  assert {
    condition = (
      azapi_resource.route["maintenance"].body.properties.cacheConfiguration.queryStringCachingBehavior == "IgnoreQueryString" &&
      azapi_resource.route["maintenance"].body.properties.cacheConfiguration.compressionSettings.isCompressionEnabled == false
    )
    error_message = "a cache block must default to ignoring query strings, uncompressed"
  }
  assert {
    condition     = azapi_resource.route["maintenance"].body.properties.originPath == "/maintenance"
    error_message = "the origin path must be sent"
  }
  assert {
    condition = (
      azapi_resource.security_policy[0].name == "ep-example-waf" &&
      azapi_resource.security_policy[0].parent_id == "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Cdn/profiles/afd-example" &&
      length(azapi_resource.security_policy[0].body.properties.parameters.associations[0].domains) == 1 &&
      azapi_resource.security_policy[0].body.properties.parameters.associations[0].patternsToMatch == tolist(["/*"])
    )
    error_message = "the security policy must be a profile child named <name>-waf, covering the endpoint's own domain"
  }
}

run "plans_a_fixed_cache_duration_as_a_route_rule_set" {
  command = plan

  variables {
    routes = {
      latest-maintenance = {
        origin_group_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Cdn/profiles/afd-example/originGroups/og-example"
        cache = {
          query_string_caching_behavior = "UseQueryString"
          duration                      = "00:01:00"
        }
      }
    }
  }

  assert {
    condition = (
      azapi_resource.cache_rule_set["latest-maintenance"].name == "latestmaintenancecache" &&
      azapi_resource.cache_rule_set["latest-maintenance"].parent_id == "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Cdn/profiles/afd-example"
    )
    error_message = "a duration must create a profile-level rule set named after the route key, without hyphens"
  }
  assert {
    condition = (
      azapi_resource.cache_rule["latest-maintenance"].body.properties.order == 0 &&
      length(azapi_resource.cache_rule["latest-maintenance"].body.properties.conditions) == 0 &&
      azapi_resource.cache_rule["latest-maintenance"].body.properties.actions[0].name == "RouteConfigurationOverride"
    )
    error_message = "the rule must be an unconditional order-0 route configuration override"
  }
  assert {
    condition = (
      azapi_resource.cache_rule["latest-maintenance"].body.properties.actions[0].parameters.cacheConfiguration.cacheBehavior == "OverrideAlways" &&
      azapi_resource.cache_rule["latest-maintenance"].body.properties.actions[0].parameters.cacheConfiguration.cacheDuration == "00:01:00" &&
      azapi_resource.cache_rule["latest-maintenance"].body.properties.actions[0].parameters.cacheConfiguration.queryStringCachingBehavior == "UseQueryString" &&
      azapi_resource.cache_rule["latest-maintenance"].body.properties.actions[0].parameters.cacheConfiguration.isCompressionEnabled == "Disabled"
    )
    error_message = "the override must carry the duration and repeat the route's cache settings"
  }
  assert {
    condition     = length(azapi_resource.route["latest-maintenance"].body.properties.ruleSets) == 1
    error_message = "the route must reference its cache rule set"
  }
}

run "plans_no_rule_set_without_a_duration" {
  command = plan

  variables {
    routes = {
      maintenance = {
        origin_group_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Cdn/profiles/afd-example/originGroups/og-example"
        cache                    = {}
      }
    }
  }

  assert {
    condition     = length(azapi_resource.cache_rule_set) == 0 && length(azapi_resource.route["maintenance"].body.properties.ruleSets) == 0
    error_message = "a cached route without a duration must create and reference no rule set"
  }
}

