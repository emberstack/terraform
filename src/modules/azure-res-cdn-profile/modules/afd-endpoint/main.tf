# =============================================================================
# FRONT DOOR ENDPOINT (Microsoft.Cdn/profiles/afdEndpoints)
# =============================================================================
# One endpoint on an existing Front Door profile, with its routes and the
# security policy that puts a WAF policy in front of it.
#
# The endpoint's hostname is `<name>-<hash>.<zone>.azurefd.net`. The hash comes
# from the name and `domain_name_label_scope`: with `TenantReuse`, the default,
# the same name anywhere in the tenant yields the same label, so a recreated
# endpoint keeps its hostname — and two live endpoints of the same name, in
# any two profiles of the tenant, collide. The scope cannot change on an
# existing endpoint; changing it here replaces the endpoint, and its hostname.
#
# The security policy is a child of the PROFILE in ARM, not of the endpoint,
# but it only means something for the domains it names, which are this
# endpoint's — so it is managed here. A domain can sit in only one security
# policy, and a WAF policy can back only one security policy per profile, so
# endpoints sharing a profile each need a WAF policy of their own. Custom
# domains are referenced by ID; they are not created here.
#
# Front Door Standard and Premium set a fixed cache lifetime only through a rule
# set rule, never on the route. A route with `cache.duration` therefore gets a
# rule set of its own, holding one order-0 rule — a rule that needs no
# condition and always runs — that overrides the route's cache configuration.
# The rule set is a profile child named after the route key, so route keys must
# be unique within the profile.
#
# Properties that can be switched off (a route's `cacheConfiguration` and
# `originPath`) are sent as null rather than left out, so that turning one off
# is a change azapi can see.
# =============================================================================

locals {
  cache_duration_routes = {
    for key, route in var.routes : key => route
    if route.cache != null && try(route.cache.duration, null) != null
  }
}

# -----------------------------------------------------------------------------
# Endpoint
# -----------------------------------------------------------------------------
# `response_export_values` is set from the first release, so it never changes on
# an existing endpoint — a change to it alone is a PUT of the unchanged body.

resource "azapi_resource" "this" {
  location  = "global"
  name      = var.name
  parent_id = var.cdn_profile_resource_id
  type      = "Microsoft.Cdn/profiles/afdEndpoints@2025-12-01"
  body = {
    properties = {
      autoGeneratedDomainNameLabelScope = var.domain_name_label_scope
      enabledState                      = var.enabled ? "Enabled" : "Disabled"
    }
  }
  replace_triggers_external_values = [var.domain_name_label_scope]
  response_export_values = {
    host_name = "properties.hostName"
  }
  tags = var.tags
}

# -----------------------------------------------------------------------------
# Cache duration rule sets
# -----------------------------------------------------------------------------
# Rule set and rule names allow letters and digits only. The override replaces
# the route's whole cache configuration, so it repeats the route's query string
# and compression settings alongside the lifetime.

resource "azapi_resource" "cache_rule_set" {
  for_each = local.cache_duration_routes

  name      = "${replace(each.key, "-", "")}cache"
  parent_id = var.cdn_profile_resource_id
  type      = "Microsoft.Cdn/profiles/ruleSets@2025-12-01"
  body      = {}
}

resource "azapi_resource" "cache_rule" {
  for_each = local.cache_duration_routes

  name      = "cacheduration"
  parent_id = azapi_resource.cache_rule_set[each.key].id
  type      = "Microsoft.Cdn/profiles/ruleSets/rules@2025-12-01"
  body = {
    properties = {
      actions = [
        {
          name = "RouteConfigurationOverride"
          parameters = {
            cacheConfiguration = {
              cacheBehavior              = each.value.cache.behavior
              cacheDuration              = each.value.cache.duration
              isCompressionEnabled       = each.value.cache.compression_enabled ? "Enabled" : "Disabled"
              queryParameters            = each.value.cache.query_parameters
              queryStringCachingBehavior = each.value.cache.query_string_caching_behavior
            }
            originGroupOverride = null
            typeName            = "DeliveryRuleRouteConfigurationOverrideActionParameters"
          }
        },
      ]
      conditions              = []
      matchProcessingBehavior = "Continue"
      order                   = 0
    }
  }
}

# -----------------------------------------------------------------------------
# Routes
# -----------------------------------------------------------------------------
# Without a `cacheConfiguration` a route does not cache at all.

resource "azapi_resource" "route" {
  for_each = var.routes

  name      = each.key
  parent_id = azapi_resource.this.id
  type      = "Microsoft.Cdn/profiles/afdEndpoints/routes@2025-12-01"
  body = {
    properties = {
      cacheConfiguration = each.value.cache == null ? null : {
        compressionSettings = {
          contentTypesToCompress = each.value.cache.content_types_to_compress
          isCompressionEnabled   = each.value.cache.compression_enabled
        }
        queryParameters            = each.value.cache.query_parameters
        queryStringCachingBehavior = each.value.cache.query_string_caching_behavior
      }
      customDomains       = [for id in each.value.custom_domain_resource_ids : { id = id }]
      enabledState        = each.value.enabled ? "Enabled" : "Disabled"
      forwardingProtocol  = each.value.forwarding_protocol
      httpsRedirect       = each.value.https_redirect_enabled ? "Enabled" : "Disabled"
      linkToDefaultDomain = each.value.link_to_default_domain ? "Enabled" : "Disabled"
      originGroup = {
        id = each.value.origin_group_resource_id
      }
      originPath      = each.value.origin_path
      patternsToMatch = each.value.patterns_to_match
      ruleSets = [
        for id in concat(
          each.value.rule_set_resource_ids,
          [for key, rule_set in azapi_resource.cache_rule_set : rule_set.id if key == each.key],
        ) : { id = id }
      ]
      supportedProtocols = each.value.supported_protocols
    }
  }

  # The rule must be in place before the route serves through its rule set.
  depends_on = [azapi_resource.cache_rule]
}

# -----------------------------------------------------------------------------
# Security policy
# -----------------------------------------------------------------------------
# Covers the endpoint's own domain plus any custom domains named. The WAF
# policy's SKU must match the profile's.

resource "azapi_resource" "security_policy" {
  count = var.security_policy == null ? 0 : 1

  name      = coalesce(var.security_policy.name, "${var.name}-waf")
  parent_id = var.cdn_profile_resource_id
  type      = "Microsoft.Cdn/profiles/securityPolicies@2025-12-01"
  body = {
    properties = {
      parameters = {
        associations = [
          {
            domains = concat(
              [{ id = azapi_resource.this.id }],
              [for id in var.security_policy.custom_domain_resource_ids : { id = id }],
            )
            patternsToMatch = var.security_policy.patterns_to_match
          },
        ]
        type = "WebApplicationFirewall"
        wafPolicy = {
          id = var.security_policy.waf_policy_resource_id
        }
      }
    }
  }
}
